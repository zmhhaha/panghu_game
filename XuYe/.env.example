# Any service that implements the OpenAI-compatible /chat/completions API.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace-me
LLM_MODEL=deepseek-chat

# Optional generation controls.
LLM_TEMPERATURE=0.9
LLM_MAX_TOKENS=1400
LLM_TIMEOUT_SECONDS=120
PORT=4173

# Production: oauth2-proxy must be the only public entry point.
XUYE_AUTH_REQUIRED=false
XUYE_TRUST_PROXY_AUTH_HEADERS=false
XUYE_DB_PATH=./xuye.db
# Kubernetes production: use the PostgreSQL URL injected from a Secret.
# DATABASE_URL=postgresql://...
