# 模型调用统一走集群内 llm-service；本服务不再持有任何 provider 凭据。
# 生产由 deploy/k8s/agent-configmap.yaml（入口、别名、长度上限）+ llm-token Secret（令牌）注入。
LLM_BASE_URL=http://llm-service.llm.svc.cluster.local/v1
LLM_MODEL=deepseek-guarded
LLM_SERVICE_TOKEN=

# LLM_MODEL 是 llm-service 注册的**别名**，不是上游模型名。
# 玩家写入的续写文字是自由文本，所以走 guarded 档：禁 tools / response_format，
# 但服务端会做不可信内容分隔（spotlight）与 canary 泄漏检测。
# ⚠️ LLM_MAX_TOKENS 受 guarded 档上限约束，最高 2048；改高会被 400 拒掉。
LLM_TEMPERATURE=0.9
LLM_MAX_TOKENS=1400
LLM_TIMEOUT_SECONDS=120

PORT=4173
HOST=127.0.0.1

# Production: oauth2-proxy must be the only public entry point.
XUYE_AUTH_REQUIRED=false
XUYE_TRUST_PROXY_AUTH_HEADERS=false
XUYE_DB_PATH=./xuye.db
# Kubernetes production: use the PostgreSQL URL injected from a Secret.
# DATABASE_URL=postgresql://...
