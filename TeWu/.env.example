# 模型调用统一走集群内 llm-service；本服务不再持有任何 provider 凭据。
# 生产由 deploy/k8s/server.yaml（入口、别名、超时）+ llm-token Secret（令牌）注入。
LLM_BASE_URL=http://llm-service.llm.svc.cluster.local/v1
LLM_MODEL=deepseek-guarded
LLM_SERVICE_TOKEN=

# 超时必须盖过服务端最坏耗时。上游是推理模型，思考与正文共用同一份预算，
# 耗时方差比直连大得多；给得太小会在 llm-service 还在生成时就 abort，
# 白白丢掉一次已经成功、只是慢的调用。
LLM_TIMEOUT_MS=60000

# LLM_MODEL 是 llm-service 注册的**别名**，不是上游模型名 —— 填 deepseek-v4-flash 之类会 400。
# 玩家能自由盘问/作答，所以走 guarded 档：禁 tools / response_format，
# 但服务端会做不可信内容分隔（spotlight）与 canary 泄漏检测。
