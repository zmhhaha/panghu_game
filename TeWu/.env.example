# Runtime settings reserved for the server-side agent adapter.
# The current browser build uses deterministic local agents and does not send these values anywhere.
PROVIDER=fallback
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_MS=8000
