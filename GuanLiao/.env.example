PORT=4173
HOST=127.0.0.1

# 留空时，非生产环境使用进程内存存档。生产环境必须提供此项。
DATABASE_URL=
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000

# 模型调用统一走集群内 llm-service；本服务不再持有任何 provider 凭据。
# 生产由 deploy/k8s/agent-configmap.yaml（入口与别名）+ llm-token Secret（令牌）注入。
LLM_BASE_URL=http://llm-service.llm.svc.cluster.local/v1
LLM_MODEL=deepseek-guarded
LLM_SERVICE_TOKEN=
LLM_TIMEOUT_MS=20000
LLM_MAX_TOKENS=1000

# LLM_MODEL 是 llm-service 注册的**别名**，不是上游模型名。
# 玩家原批是自由文本，所以走 guarded 档：禁 tools / response_format，
# 但服务端会做不可信内容分隔（spotlight）与 canary 泄漏检测。
# LLM_BASE_URL / LLM_SERVICE_TOKEN 缺失时服务不报错，只退回主控给出的确定性文本 ——
# 所以标准 deploy.sh 会先等待 llm-token Secret，避免声明启用模型却以 fallback 状态上线。

# 生产环境应置于 oauth2-proxy 后，并只信任代理清洗后的身份头。
TRUST_PROXY_AUTH_HEADERS=false
