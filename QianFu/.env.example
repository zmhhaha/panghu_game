# Local development can omit DATABASE_URL and use volatile in-memory storage.
DATABASE_URL=postgresql://qianfu:change-me@localhost:5432/qianfu
PORT=3001

# Production must receive identity headers only from the trusted oauth2-proxy path.
TRUST_PROXY_AUTH_HEADERS=false

# 模型调用统一走集群内 llm-service；本服务不再持有任何 provider 凭据。
# 生产由 deploy/k8s/agent-configmap.yaml（入口与别名）+ llm-token Secret（令牌）注入。
LLM_BASE_URL=http://llm-service.llm.svc.cluster.local/v1
LLM_MODEL=deepseek-guarded
LLM_SERVICE_TOKEN=
LLM_TIMEOUT_MS=8000

# LLM_MODEL 是 llm-service 注册的**别名**，不是上游模型名。
