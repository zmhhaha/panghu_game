NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appdb
COMMENT_CONFIRMATION_SECRET=replace-with-at-least-32-random-characters

# 模型调用统一走集群内 llm-service；本服务不再持有任何 provider 凭据。
# 生产由 deploy/k8s/agent-configmap.yaml（入口与别名）+ llm-token Secret（令牌）注入。
LLM_BASE_URL=http://llm-service.llm.svc.cluster.local/v1
LLM_MODEL=deepseek-guarded
LLM_SERVICE_TOKEN=
LLM_TIMEOUT_MS=120000

# LLM_MODEL 是 llm-service 注册的**别名**，不是上游模型名。
# 玩家发言是自由文本，所以走 guarded 档：禁 tools / response_format，
# 但服务端会做不可信内容分隔（spotlight）与 canary 泄漏检测。
# TaShuo 不提供 fallback：LLM_BASE_URL 或 LLM_SERVICE_TOKEN 缺失时进程直接拒绝启动。
